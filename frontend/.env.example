# frontend/.env.example — Vite only reads VITE_* vars

# Base URL of the UniMap API. Proxied through the dev server (see
# vite.config.js) so the browser sees same-origin /api calls and there
# is no CORS in development.
VITE_API_TARGET=http://localhost:4000

# Routing is in-process on the API (A* over graph_edges), so there is no
# external routing base URL to configure and nothing to rate-limit.
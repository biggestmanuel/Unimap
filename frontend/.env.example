# frontend/.env.example — Vite only reads VITE_* vars

# Base URL of the UniMap API. Proxied through the dev server (see
# vite.config.js) so the browser sees same-origin /api calls and there
# is no CORS in development.
VITE_API_TARGET=http://localhost:4000

# Routing is in-process on the API (A* over graph_edges), so there is no
# external routing base URL to configure and nothing to rate-limit.

# Map tiles. The default is the public OSM server, which is fine for
# development but is rate-limited and not guaranteed offline.
#
# For real campus traffic, self-host (see docs/TILES.md) and point this at
# your own TileServer, e.g.:
#   VITE_TILE_URL=http://localhost:8080/tiles/{z}/{x}/{y}.png
#   VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
VITE_TILE_MAX_ZOOM=19
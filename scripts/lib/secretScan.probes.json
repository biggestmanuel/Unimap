{
  "_comment": "Probe strings for check 8 of `npm run check`, which proves the credential scanner still detects credentials. Every value here is synthetic. This file is exempt from the scan for the same reason docs/SECURITY.md is: it has to contain things that look like secrets in order to prove they are caught. Do not put a real credential in this file.",
  "cases": [
    { "label": "neon production URL", "sample": "DATABASE_URL=postgres://unimap_owner:s3cr3tP4ss@ep-cool-123.us-east-2.aws.neon.tech/unimap", "shouldCatch": true },
    { "label": "the same URL in prose", "sample": "see `postgres://u:reallookingpass@db.acme.com/prod` for details", "shouldCatch": true },
    { "label": "a password containing the word example", "sample": "postgres://admin:myexamplepassword1@db.acme.com/x", "shouldCatch": true },
    { "label": "neon API key", "sample": "const k = \"npg_ABCDEFGHIJKLMNOPQRSTUVWXYZ012345\";", "shouldCatch": true },
    { "label": "neon owner role", "sample": "psql -U neondb_owner", "shouldCatch": true },
    { "label": "private key", "sample": "-----BEGIN RSA PRIVATE KEY-----", "shouldCatch": true },
    { "label": "aws key id", "sample": "AKIAIOSFODNN7EXAMPLE", "shouldCatch": true },
    { "label": "github token", "sample": "ghp_abcdefghijklmnopqrstuvwxyz0123456789", "shouldCatch": true },
    { "label": "stripe key", "sample": "sk_abcdefghijklmnopqrstuvwxyz0123456789", "shouldCatch": true },

    { "label": "localhost, plain", "sample": "postgres://unimap:unimap_dev@localhost:5432/unimap", "shouldCatch": false },
    { "label": "localhost, in backticks", "sample": "`postgres://unimap:unimap_dev@localhost` is the default", "shouldCatch": false },
    { "label": "loopback by ip", "sample": "postgres://u:p@127.0.0.1:5432/db", "shouldCatch": false },
    { "label": "docker host gateway", "sample": "postgres://u:p@host.docker.internal:5432/db", "shouldCatch": false },
    { "label": "ipv6 loopback", "sample": "postgres://u:p@[::1]:5432/db", "shouldCatch": false },
    { "label": "a named placeholder", "sample": "postgres://user:your-password@db.example.com:5432/db", "shouldCatch": false },
    { "label": "a deliberately wrong password in a smoke test", "sample": "body: JSON.stringify({ password: 'wrong-password' })", "shouldCatch": false },
    { "label": "wrong as a substring, not a word", "sample": "postgres://admin:myworship7@db.acme.com/x", "shouldCatch": true },
    { "label": "bogus as a substring, not a word", "sample": "postgres://admin:obfusc8tion@db.acme.com/x", "shouldCatch": true },
    { "label": "no password at all", "sample": "postgres://unimap@ep-x.us-east-2.aws.neon.tech/unimap", "shouldCatch": false },
    { "label": "ordinary source", "sample": "const timeout = 30; fetch(url, { signal });", "shouldCatch": false }
  ]
}

# Copy to .env and adjust. Never commit .env.

# Postgres / PostGIS. Port 5433 matches docker-compose.yml; change if local.
DATABASE_URL=postgres://unimap:unimap_dev@localhost:5433/unimap

PORT=4000

NODE_ENV=development

# Where the frontend dev server proxies /api. Optional.
VITE_API_TARGET=http://localhost:4000

# Import the OSM walk network into graph_edges:
#   npm run migrate && node src/graph/importOsm.js
# Routing then runs in-process; there is no external routing service.